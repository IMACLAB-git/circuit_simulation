{
  "name": "circuit-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "check": "esbuild src/dev/engine-check.ts --bundle --platform=node --format=esm --outfile=.tmp/engine-check.mjs --log-level=warning && node .tmp/engine-check.mjs",
    "build:single": "vite build && node scripts/bundle-single.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "esbuild": "^0.24.0"
  }
}
